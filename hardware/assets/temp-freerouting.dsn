    (net "Net-(BT1--)"
      (pins BT1-2 R2-2 R1-2)
    )
    (net "Net-(D2-A)"
      (pins D2-2 R2-1)
    )
    (class kicad_default "Net-(BT1-+)" "Net-(BT1--)" "Net-(D1-A)" "Net-(D1-K)"
      "Net-(D2-A)" "Net-(D2-K)"
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
